<Window x:Class="Roomy.Views.ProgramsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Программы · Roomy" Width="1080" Height="700" MinWidth="820" MinHeight="550"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="MutedText">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Surface2Brush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    Content="Обновить" Padding="15,7" Click="Refresh_Click" />
            <TextBlock Text="Программы" FontSize="29" FontWeight="Bold" FontFamily="{StaticResource DisplayFont}" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,16,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <TextBox x:Name="SearchBox" Padding="10,7" VerticalContentAlignment="Center"
                         Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                         CaretBrush="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"
                         AutomationProperties.Name="Поиск программы" TextChanged="Filter_Changed" />
                <TextBlock Text="Поиск по названию или издателю" Margin="11,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource MutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox x:Name="DriveFilter" Grid.Column="1" MinWidth="108" Margin="0,0,12,0"
                      Style="{StaticResource DarkComboBox}"
                      VerticalContentAlignment="Center" AutomationProperties.Name="Диск"
                      SelectionChanged="Filter_Changed" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="ListMode" Style="{StaticResource SegmentTab}" GroupName="ProgramView"
                             Content="Список" IsChecked="True" Checked="Mode_Changed" />
                <RadioButton x:Name="MapMode" Style="{StaticResource SegmentTab}" GroupName="ProgramView"
                             Content="Карта программ" Checked="Mode_Changed" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox x:Name="ProgramList" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Список программ по размеру" SelectionChanged="Program_Changed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" FontSize="13" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid x:Name="MapHost" Visibility="Collapsed" Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Canvas x:Name="MapCanvas" ClipToBounds="True" SizeChanged="Map_Resized" />
                        <TextBlock x:Name="MapCaption" Grid.Row="1" Style="{StaticResource MutedText}" Margin="0,6,0,0" FontSize="12" />
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <TextBlock x:Name="EmptyDetails" Text="Выберите программу, чтобы посмотреть её папки."
                               Style="{StaticResource MutedText}" VerticalAlignment="Center" TextAlignment="Center" />
                    <Grid x:Name="Details" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock x:Name="ProgramName" FontSize="23" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ProgramDetail" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Folders" />
                        </ScrollViewer>
                        <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                            <Button x:Name="ProjectButton" Content="Привязать проект" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,6" Padding="10,7" Click="AddProject_Click" />
                            <Button x:Name="RemoveButton" Content="Удалить программу" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,6,6" Padding="10,7" Click="Remove_Click" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Style="{StaticResource MutedText}" Margin="0,11,0,0"
                   AutomationProperties.LiveSetting="Polite" MinHeight="38" />
    </Grid>
</Window>
